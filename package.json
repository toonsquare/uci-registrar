{
  "name": "uci-registrar",
  "productName": "UCI 등록 도우미",
  "version": "1.0.0",
  "description": "국립중앙도서관 UCI 발급·등록 지원 프로그램",
  "main": "src/main/index.js",
  "author": {
    "name": "Toonsquare",
    "email": "jonathan@tooning.io"
  },
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "node scripts/make-icon.js",
    "build:win": "node scripts/build.js",
    "build:demo": "node scripts/build-demo.js",
    "build": "npm run build:win",
    "test": "electron test/run.js",
    "test:screen": "electron test/screen.js",
    "test:all": "npm test && npm run test:screen && npm run test:demo",
    "test:demo": "electron test/demo-flow.js",
    "lint": "eslint src test scripts",
    "coverage": "node scripts/coverage-report.js",
    "quality": "npm run lint && npm run coverage"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1"
  },
  "build": {
    "appId": "io.tooning.uci.registrar",
    "productName": "UCI 등록 도우미",
    "copyright": "Copyright © 2026 Toonsquare",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "UCI-Registrar-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UCI 등록 도우미",
      "installerLanguages": [
        "ko-KR"
      ],
      "language": "1042"
    }
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
